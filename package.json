{
  "name": "3d-review",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "stamp": "node scripts/stamp-version.mjs",
    "pretypecheck": "npm run stamp",
    "pretest": "npm run stamp",
    "predev": "npm run stamp",
    "dev": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 execute 3d-review-dev --local --file=migrations/0001_init.sql",
    "migrate:escrow:local": "wrangler d1 execute 3d-review-dev --local --file=migrations/0002_code_escrow.sql",
    "seed:local": "wrangler d1 execute 3d-review-dev --local --file=seed/synthetic.sql && wrangler d1 execute 3d-review-dev --local --file=seed/synthetic-responses.sql",
    "parity": "node scripts/parity.mjs",
    "journeys": "node scripts/journeys.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.30.0"
  }
}
